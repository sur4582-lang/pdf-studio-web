# Copy to .env (local) or add as Environment Variables on your host.
SITE_NAME=PDF Studio Pro
SITE_URL=https://yourdomain.com        # no trailing slash (used in sitemap/canonical)
AUTHOR=Brajesh Yadav
CONTACT_EMAIL=you@yourdomain.com
SOURCE_URL=https://github.com/YOURNAME/pdf-studio-web   # required by AGPL (PyMuPDF), see README
# ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX                  # after AdSense approval
# ANALYTICS_ID=G-XXXXXXXXXX
# GSC_VERIFY=token-from-search-console
MAX_UPLOAD_MB=50
MAX_FILES=20
MAX_PAGES=400
MAX_PARALLEL_JOBS=2
RATE_LIMIT=30
RESULT_TTL_SEC=600
